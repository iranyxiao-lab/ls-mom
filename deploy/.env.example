# 复制为 .env 后按需修改。以下为本地开发默认值，生产环境必须全部替换。
COMPOSE_PROJECT_NAME=lsmom

# 对外端口
LSMOM_HTTP_PORT=80
LSMOM_DB_PORT=5432

# PostgreSQL
DB_NAME=lsmom
DB_USER=lsmom
DB_PASSWORD=lsmom-local-only

# Redis
REDIS_PASSWORD=lsmom-local-only

# 管理端点 /actuator 的 Basic 认证账号
MONITOR_USERNAME=lsmom-monitor
MONITOR_PASSWORD=lsmom-local-only

# 对象存储（SeaweedFS，S3 兼容）
S3_ACCESS_KEY=lsmom
S3_SECRET_KEY=lsmom-local-only
S3_BUCKET=lsmom

# 演示种子（本地与验收环境为 true，生产必须为 false）
LSMOM_SEED_DEMO_ENABLED=true

# 构建镜像时使用的依赖镜像源（留空则用官方源）
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com

# 登录验证码（生产必须为 true；仅自动化验收环境可设为 false）
CAPTCHA_ENABLED=true
