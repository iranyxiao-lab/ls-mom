  "seeds": [],
  "tests": [
    {
      "name": "申请、批准并关闭作业许可",
      "steps": [
        {
          "create": {
            "concept": "acme.permit.Permit",
            "as": "p1",
            "values": {
              "permitNo": "HP-001",
              "workType": "HOT",
              "location": "储罐区"
            }
          }
        },
        {
          "op": {
            "code": "acme.permit.Permit.submit",
            "target": "p1"
          }
        },
        {
          "expectError": {
            "code": "GUARD_FAILED",
            "op": {
              "code": "acme.permit.Permit.approve",
              "target": "p1"
            }
          }
        },
        {
          "op": {
            "code": "acme.permit.Permit.approve",
            "target": "p1",
            "as": "HUMAN"
          }
        },
        {
          "expect": {
            "concept": "acme.permit.Permit",
            "target": "p1",
            "status": "APPROVED",
            "values": {
              "location": "储罐区"
            }
          }
        },
        {
          "op": {
            "code": "acme.permit.Permit.close",
            "target": "p1"
          }
        },
        {
          "expect": {
            "concept": "acme.permit.Permit",
            "target": "p1",
            "status": "CLOSED"
          }
        },
        {
          "expectError": {
            "code": "INVALID_TRANSITION",
            "op": {
              "code": "acme.permit.Permit.approve",
              "target": "p1",
              "as": "HUMAN"
            }
          }
        }
      ]
    }
