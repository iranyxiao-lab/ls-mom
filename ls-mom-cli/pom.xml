<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lsmom</groupId>
        <artifactId>ls-mom-modules</artifactId>
        <version>${revision}</version>
        <relativePath>../ls-mom-modules/pom.xml</relativePath>
    </parent>

    <artifactId>ls-mom-cli</artifactId>

    <description>构建期工具：LS-IR 校验与生成（Pack 目录、Operation 骨架、JUnit 测试、ChangeSet 制品）、构建期 Copilot、Frappe 静态转换。不含任何发布能力</description>

    <dependencies>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-pack</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-ai</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <!-- 测试：在临时数据库（Testcontainers）安装生成的 Pack 并运行生成的测试 -->
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-core</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-action</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-crud</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-form</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-flow</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-pack</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ls-mom-cli</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- LS-IR Schema 放在模块根 schema/ 下，同时打进 jar -->
            <resource>
                <directory>schema</directory>
                <targetPath>schema</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.lsmom.cli.LsMomCli</mainClass>
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
