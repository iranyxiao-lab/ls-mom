{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsmom.local/schema/mobile.schema.json",
  "title": "LS MobileSchema",
  "description": "移动端只显示必要字段；提交时仍按完整 FormSchema 服务端校验。",
  "type": "object",
  "required": ["viewType", "formCode", "version", "conceptCode", "fields"],
  "additionalProperties": false,
  "properties": {
    "viewType": { "const": "MOBILE" },
    "formCode": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "conceptCode": { "type": "string" },
    "title": { "type": "string", "maxLength": 100 },
    "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 64 } },
    "photo": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": { "field": { "type": "string", "maxLength": 64 }, "maxCount": { "type": "integer", "minimum": 1, "maximum": 20 } }
    },
    "offlineDraft": { "type": "boolean" },
    "actions": { "type": "array", "items": { "$ref": "form.schema.json#/$defs/action" } }
  }
}
