{
  "viewType": "FORM",
  "formCode": "ls.asset.defectForm",
  "version": 2,
  "conceptCode": "ls.asset.Defect",
  "title": "设备缺陷",
  "layout": [
    {
      "type": "row",
      "children": [
        {
          "type": "col",
          "span": 12,
          "children": [
            {
              "type": "field",
              "key": "asset"
            }
          ]
        },
        {
          "type": "col",
          "span": 12,
          "children": [
            {
              "type": "field",
              "key": "location"
            }
          ]
        },
        {
          "type": "col",
          "span": 12,
          "children": [
            {
              "type": "field",
              "key": "reporter"
            }
          ]
        },
        {
          "type": "col",
          "span": 12,
          "children": [
            {
              "type": "field",
              "key": "reportedAt"
            }
          ]
        }
      ]
    },
    {
      "type": "field",
      "key": "title"
    },
    {
      "type": "field",
      "key": "severity"
    },
    {
      "type": "field",
      "key": "symptom"
    }
  ],
  "fields": [
    {
      "key": "asset",
      "label": "设备",
      "widget": "assetRef",
      "required": true,
      "defaultFrom": "$source.id",
      "ref": {
        "concept": "ls.asset.Asset",
        "labelField": "name"
      }
    },
    {
      "key": "location",
      "label": "位置",
      "widget": "input",
      "maxLength": 128,
      "defaultFrom": "$source.location"
    },
    {
      "key": "reporter",
      "label": "登记人",
      "widget": "userRef",
      "defaultFrom": "$user"
    },
    {
      "key": "reportedAt",
      "label": "登记时间",
      "widget": "datetime",
      "defaultFrom": "$now"
    },
    {
      "key": "title",
      "label": "缺陷描述",
      "widget": "input",
      "required": true
    },
    {
      "key": "severity",
      "label": "严重度",
      "widget": "select",
      "required": true,
      "options": [
        {
          "label": "低",
          "value": "LOW"
        },
        {
          "label": "中",
          "value": "MEDIUM"
        },
        {
          "label": "高",
          "value": "HIGH"
        },
        {
          "label": "严重",
          "value": "CRITICAL"
        }
      ],
      "remember": true,
      "default": "MEDIUM"
    },
    {
      "key": "symptom",
      "label": "现象",
      "widget": "textarea"
    }
  ]
}