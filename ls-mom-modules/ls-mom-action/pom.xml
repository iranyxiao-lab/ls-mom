<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lsmom</groupId>
        <artifactId>ls-mom-modules</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ls-mom-action</artifactId>

    <description>Operation Gateway：权限、守卫、幂等、审计、状态机</description>

    <dependencies>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-meta</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Operation 输入/输出 JSON Schema 校验（Apache-2.0） -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>2.0.4</version>
        </dependency>
        <!-- 受限 CEL 规则求值（Apache-2.0） -->
        <dependency>
            <groupId>dev.cel</groupId>
            <artifactId>cel</artifactId>
            <version>0.15.0</version>
        </dependency>
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-satoken</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lsmom</groupId>
            <artifactId>ls-mom-core</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 导出测试装配（ActionFixture）给依赖 action 的模块测试复用 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
