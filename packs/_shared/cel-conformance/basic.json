{
  "description": "受限 CEL 前后端一致性用例：后端 CelConformanceTest（cel-java）与前端 tests/unit/cel-conformance.spec.ts（@bufbuild/cel）同跑。expect.value 为求值结果；expect.error 为求值失败（按规则失败处理）；expect.invalid 为发布校验拒绝的错误编码。",
  "cases": [
    { "name": "整数比较", "expr": "$model.qty > 10 && $model.qty <= 20", "model": { "qty": 12 }, "expect": { "value": true } },
    { "name": "整数与小数比较", "expr": "$model.qty < 12.5", "model": { "qty": 12 }, "expect": { "value": true } },
    { "name": "小数相等", "expr": "$model.price == 2.5", "model": { "price": 2.5 }, "expect": { "value": true } },
    { "name": "四则运算", "expr": "$model.qty * 2 + 1 - $model.qty / 4", "model": { "qty": 12 }, "expect": { "value": 22 } },
    { "name": "整数取余", "expr": "$model.qty % 5", "model": { "qty": 12 }, "expect": { "value": 2 } },
    { "name": "整数除法截断", "expr": "7 / 2", "model": {}, "expect": { "value": 3 } },
    { "name": "显式转小数", "expr": "double($model.qty) * $model.price", "model": { "qty": 12, "price": 2.5 }, "expect": { "value": 30 } },
    { "name": "int 与 double 相加不允许隐式转换", "expr": "$model.qty + $model.price > 0", "model": { "qty": 12, "price": 2.5 }, "expect": { "error": true } },
    { "name": "除以零", "expr": "$model.qty / 0 == 1", "model": { "qty": 1 }, "expect": { "error": true } },
    { "name": "逻辑与或非", "expr": "!($model.a && $model.b) || $model.c", "model": { "a": true, "b": true, "c": false }, "expect": { "value": false } },
    { "name": "短路：错误被 false 吸收", "expr": "false && $model.missing == 1", "model": {}, "expect": { "value": false } },
    { "name": "短路：错误被 true 吸收", "expr": "$model.missing == 1 || true", "model": {}, "expect": { "value": true } },
    { "name": "缺失字段报错", "expr": "$model.missing == 1", "model": {}, "expect": { "error": true } },
    { "name": "has 判断存在", "expr": "has($model.plannedEnd)", "model": { "plannedEnd": "2026-12-01T18:00:00" }, "expect": { "value": true } },
    { "name": "has 判断缺失", "expr": "has($model.plannedEnd)", "model": {}, "expect": { "value": false } },
    { "name": "null 字段视为未填写", "expr": "has($model.plannedEnd)", "model": { "plannedEnd": null }, "expect": { "value": false } },
    { "name": "访问 null 字段报错", "expr": "$model.plannedEnd == null", "model": { "plannedEnd": null }, "expect": { "error": true } },
    { "name": "列表中的 null 保留", "expr": "$model.list[1] == null && size($model.list) == 2", "model": { "list": [1, null] }, "expect": { "value": true } },
    { "name": "枚举 in", "expr": "$model.severity in ['HIGH', 'CRITICAL']", "model": { "severity": "HIGH" }, "expect": { "value": true } },
    { "name": "枚举 not in", "expr": "!($model.severity in ['HIGH', 'CRITICAL'])", "model": { "severity": "LOW" }, "expect": { "value": true } },
    { "name": "范围", "expr": "$model.temp >= -10 && $model.temp <= 85.5", "model": { "temp": 36.6 }, "expect": { "value": true } },
    { "name": "正则", "expr": "$model.code.matches('^WO-[0-9]{4}-[0-9]+$')", "model": { "code": "WO-2026-001" }, "expect": { "value": true } },
    { "name": "正则不匹配", "expr": "$model.code.matches('^WO-[0-9]{4}$')", "model": { "code": "WO-2026-001" }, "expect": { "value": false } },
    { "name": "正则部分匹配", "expr": "$model.code.matches('2026')", "model": { "code": "WO-2026-001" }, "expect": { "value": true } },
    { "name": "字符串长度（码点）", "expr": "size($model.name)", "model": { "name": "张三丰" }, "expect": { "value": 3 } },
    { "name": "列表长度", "expr": "size($model.tags) == 2", "model": { "tags": ["a", "b"] }, "expect": { "value": true } },
    { "name": "方法式长度", "expr": "$model.name.size()", "model": { "name": "abc" }, "expect": { "value": 3 } },
    { "name": "前后缀与包含", "expr": "$model.s.startsWith('LS') && $model.s.endsWith('01') && $model.s.contains('-MOM-')", "model": { "s": "LS-MOM-01" }, "expect": { "value": true } },
    { "name": "字符串拼接", "expr": "$model.a + '-' + $model.b", "model": { "a": "X", "b": "Y" }, "expect": { "value": "X-Y" } },
    { "name": "字符串字典序比较", "expr": "$context.now > '2026-01-01'", "model": {}, "context": { "now": "2026-11-10T08:00:00" }, "expect": { "value": true } },
    { "name": "三元", "expr": "$model.qty > 10 ? 'BIG' : 'SMALL'", "model": { "qty": 3 }, "expect": { "value": "SMALL" } },
    { "name": "嵌套对象", "expr": "$model.assignee.dept == 'QA' && $context.actor.partyId == 7", "model": { "assignee": { "dept": "QA" } }, "context": { "actor": { "partyId": 7 } }, "expect": { "value": true } },
    { "name": "下标访问", "expr": "$model.items[0].qty + $model['extra']", "model": { "items": [{ "qty": 2 }], "extra": 3 }, "expect": { "value": 5 } },
    { "name": "列表越界", "expr": "$model.items[3] == 1", "model": { "items": [1] }, "expect": { "error": true } },
    { "name": "类型转换", "expr": "int('42') + int(2.9) == 44 && string(7) == '7' && bool('true')", "model": {}, "expect": { "value": true } },
    { "name": "字面量含 $ 不替换", "expr": "'$model' == '$' + 'model'", "model": {}, "expect": { "value": true } },
    { "name": "条件必填", "expr": "!($model.result == 'FAIL') || (has($model.reason) && size($model.reason) > 0)", "model": { "result": "FAIL" }, "expect": { "value": false } },
    { "name": "非白名单函数", "expr": "exec($model.cmd) == 0", "model": {}, "expect": { "invalid": "RULE_ILLEGAL_FUNCTION", "function": "exec" } },
    { "name": "推导式 all 被禁用", "expr": "$model.tags.all(t, t != '')", "model": {}, "expect": { "invalid": "RULE_ILLEGAL_FUNCTION", "function": "all" } },
    { "name": "推导式 exists 被禁用", "expr": "$model.tags.exists(t, t == 'a')", "model": {}, "expect": { "invalid": "RULE_ILLEGAL_FUNCTION", "function": "exists" } },
    { "name": "timestamp 不在白名单", "expr": "timestamp('2026-01-01T00:00:00Z') != null", "model": {}, "expect": { "invalid": "RULE_ILLEGAL_FUNCTION", "function": "timestamp" } },
    { "name": "未声明变量", "expr": "other.x == 1", "model": {}, "expect": { "invalid": "RULE_INVALID" } },
    { "name": "非法 $ 变量", "expr": "$env.secret == 'x'", "model": {}, "expect": { "invalid": "RULE_INVALID" } },
    { "name": "语法错误", "expr": "$model.a ==", "model": {}, "expect": { "invalid": "RULE_INVALID" } },
    { "name": "超长", "expr": "REPEAT:$model.a == 1 || :300:$model.a == 1", "model": {}, "expect": { "invalid": "RULE_TOO_COMPLEX" } }
  ]
}
